{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsObservabilityEks",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::124666675812:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:ericnsoh/observability-eks-helm:*",
            "repo:ericnsoh@*/observability-eks-helm@*:*"
          ]
        }
      }
    }
  ]
}
